/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode(int x) { val = x; }
 * }
 */

// Method 1 --------------------------------------------------------------------------------(TC = 15ms)
class Solution {
    public TreeNode lowestCommonAncestor(TreeNode root, TreeNode p, TreeNode q) {
        if(root == null){
            return null;
        }
        // if current node is p or q
        if(root == p || root == q){
            return root;
        }
        // search both sides recursively
        TreeNode left = lowestCommonAncestor(root.left, p , q);
        TreeNode right = lowestCommonAncestor(root.right, p , q);
        // one node found on each side
        if(left != null && right != null){
            return root;
        }
        // return the side where node was found
        if(left != null){
            return left;
        }
        else{
            return right;
        }
    }
}

// Method 2 -------------------------------------------------------------------------------------(TC = 15ms)
class Solution {
    public TreeNode lowestCommonAncestor(TreeNode root, TreeNode p, TreeNode q) {
        // If there is nothing, or I found one of the targets, return it
        if(root == null || root == p || root == q){
            return root;
        }
        // search left and right side 
        TreeNode left = lowestCommonAncestor(root.left,p,q);
        TreeNode right = lowestCommonAncestor(root.right,p,q);
        // Nothing found on the left 
        if(left==null){
            // return whatever was found on the right
            return right;
        }
        // Nothing found on the right 
        if(right==null) {
            // return whatever was found on the left
            return left;
        }
        // targets found on both sides means current root is LCA
        return root;
    }
}
