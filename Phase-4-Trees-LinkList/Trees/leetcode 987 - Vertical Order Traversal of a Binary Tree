/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    // col => [level => [list]]
    TreeMap<Integer, TreeMap<Integer, ArrayList<Integer>>> map = new TreeMap<>();

    private void dfs(TreeNode root, int col, int lvl){
        if(root == null){
            return;
        }
        // create column in map
        if(!map.containsKey(col)){
            map.put(col, new TreeMap<>());
        }
        // create level in map
        if(!map.get(col).containsKey(lvl)){
            map.get(col).put(lvl, new ArrayList<>());
        }
        // insert root.val in map
        map.get(col).get(lvl).add(root.val);
        // recursively insert values in the map
        dfs(root.left, col-1, lvl+1);
        dfs(root.right, col+1, lvl+1);
    }
    public List<List<Integer>> verticalTraversal(TreeNode root) {
        List<List<Integer>> resList = new ArrayList<>();
        if(root == null){
            return resList;
        }
        dfs(root, 0, 0);
        // sort according column and add values in result list
        for(Map.Entry<Integer, TreeMap<Integer, ArrayList<Integer>>> i : map.entrySet()){
            TreeMap<Integer, ArrayList<Integer>> lvlMap = i.getValue();
            ArrayList<Integer> list = new ArrayList<>();
            // sort according level and add values in result sublist
            for(Map.Entry<Integer, ArrayList<Integer>> j : lvlMap.entrySet()){
                ArrayList<Integer> subList = j.getValue();
                Collections.sort(subList);
                list.addAll(subList);
            }
            // add list items to main List
            resList.add(list);
        }
        return resList;
    }
}
