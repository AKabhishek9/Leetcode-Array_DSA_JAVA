/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */

// Approach 1 -------------------------------------------------------------------(TC = 1ms)
class Solution {

    public void dfs(TreeNode root, ArrayList<Integer> list){
        if(root == null){
            return;
        }
        // Use Inorder traversal to store values in seq.
        dfs(root.left, list);
        list.add(root.val);
        dfs(root.right, list);
    }
    public int kthSmallest(TreeNode root, int k) {
        ArrayList<Integer> list = new ArrayList<>();
        dfs(root, list);
        // return the kth element 
        return list.get(k-1);
    }
}

// Approach 2 ----------------------------------------------------------------(BEST TC = 0ms)
class Solution {
    int cnt = 0;
    public int dfs(TreeNode root, int k){
        if(root == null){
            return -1;
        }
        // Use Inorder traversal to store values in seq.
        // visit left first
        int left = dfs(root.left, k);
        // kth element already found
        if(left != -1){
            return left;
        }
        cnt++;
        if(cnt == k){
            return root.val;
        }
        // visit right subtree
        return dfs(root.right, k);
    }
    public int kthSmallest(TreeNode root, int k) {
        return dfs(root, k);
    }
}
