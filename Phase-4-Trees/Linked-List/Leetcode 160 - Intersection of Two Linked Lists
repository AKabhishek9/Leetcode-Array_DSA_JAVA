/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode(int x) {
 *         val = x;
 *         next = null;
 *     }
 * }
 */
public class Solution {
    public ListNode getIntersectionNode(ListNode headA, ListNode headB) {
        HashSet<ListNode> map = new HashSet<>();
        ListNode temp = headA;
        // add nodes of list 1 in the hashset
        while(temp != null){
            map.add(temp);
            temp = temp.next;
        }
        temp = headB;
        while(temp != null){
            // chaek that the node of list 2 present in Hashset
            if(map.contains(temp)){
                return temp;
            }
            temp = temp.next;
        }
        return null;
    }
}
