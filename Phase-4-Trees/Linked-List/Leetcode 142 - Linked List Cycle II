/**
 * Definition for singly-linked list.
 * class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode(int x) {
 *         val = x;
 *         next = null;
 *     }
 * }
 */

// Approach 1 ------------------------------------------------------(TC = 6ms)
public class Solution {
    public ListNode detectCycle(ListNode head) {
        HashMap<ListNode, Integer> mp = new HashMap<>();
        ListNode temp = head;
        while(temp != null){
            // if node not found put it into the map
            if(!mp.containsKey(temp)){
                mp.put(temp, 1);
            }
            // node found in map means from here cycle starts
            else{
                return temp;
            }
            temp = temp.next;
        }
        return null;
    }
}

// Approach 2 -----------------------------------------------------------(BEST TC = 0ms)
public class Solution {
    public ListNode detectCycle(ListNode head) {
        ListNode slow = head;
        ListNode fast = head;
        while(fast != null && fast.next != null){
            slow = slow.next;
            fast = fast.next.next;
            // cycle is detected
            if(slow == fast){
                // set slow to starting of LL
                slow = head;
                // move both slow and fast 1 by 1 until slow = fast
                while(slow != fast){
                    slow = slow.next;
                    fast = fast.next;
                }
                return slow;
            }
        }
        return null;
    }
}
