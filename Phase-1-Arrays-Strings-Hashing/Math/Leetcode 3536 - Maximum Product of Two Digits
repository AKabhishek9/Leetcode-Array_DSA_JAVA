// Approach 1 (Brute Force) -------------------------------------------------(TC = 1ms)
class Solution {
    public int maxProduct(int n) {
        int arr[] = new int[10];
        int idx = 0;
        // convert number into an array
        while(n != 0){
            arr[idx++] = n%10;
            n /= 10;
        }
        int prod = 0;
        int ans = Integer.MIN_VALUE;
        // find max product 
        for(int i = 0; i < idx; i++){
            for(int j = i+1; j < idx; j++){
                prod = arr[i]*arr[j];
                ans = Math.max(ans, prod);
            }
        }
        return ans;
    }
}

// Approach 2 --------------------------------------------------------------(BEST TC = 1ms)
class Solution {
    public int maxProduct(int n) {
        int max1 = Integer.MIN_VALUE;
        int max2 = Integer.MIN_VALUE;
        while(n != 0){
            int digit = n%10;
            // find largest digit
            if(digit > max1){
                max2 = max1;
                max1 = digit;
            }
            // find second largest degit
            else if(digit > max2){
                max2 = digit;
            }
            n/=10;
        }
        return max2*max1;
    }
}
