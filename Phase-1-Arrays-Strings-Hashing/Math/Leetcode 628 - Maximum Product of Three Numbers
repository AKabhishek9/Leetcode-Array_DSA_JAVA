// Approach 1 (Brute Force) ------------------------------------------------(Gives TLE)
class Solution {
    public int maximumProduct(int[] nums) {
        int ans = Integer.MIN_VALUE;
        for(int i = 0; i < nums.length; i++){
            for(int j = i+1; j < nums.length; j++){
                for(int k = j+1; k < nums.length; k++){
                    ans = Math.max(ans, nums[i]*nums[j]*nums[k]);
                }
            }
        }
        return ans;
    }
}

// Approach 2 -------------------------------------------------------------------(BEST TC = 3ms)
class Solution {
    public int maximumProduct(int[] nums) {
        int max1 = Integer.MIN_VALUE;
        int max2 = Integer.MIN_VALUE;
        int max3 = Integer.MIN_VALUE;
        int min1 = Integer.MAX_VALUE;
        int min2 = Integer.MAX_VALUE;
        for(int i = 0; i < nums.length; i++){
            // find largest no.
            if(nums[i] > max1){
                max3 = max2;
                max2 = max1;
                max1 = nums[i];
            }
            // find second largest no.
            else if(nums[i] > max2){
                max3 = max2;
                max2 = nums[i];
            }
            // find third largest no.
            else if(nums[i] > max3){
                max3 = nums[i];
            }

            // find two min. numbers because 
            // (most -ve) * (most -ve) gives max. product
            if(nums[i] < min1){
                min2 = min1;
                min1 = nums[i];
            }
            else if(nums[i] < min2){
                min2 = nums[i];
            }
        }
        // return product which gives max value
        return Math.max(max1*max2*max3, max1*min1*min2);
    }
}
