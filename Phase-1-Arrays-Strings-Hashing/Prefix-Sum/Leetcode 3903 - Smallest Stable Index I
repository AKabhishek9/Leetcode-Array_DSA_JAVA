class Solution {
    public int firstStableIndex(int[] nums, int k) {
        int n =  nums.length;
        int max = Integer.MIN_VALUE;
        int minArr[] = new int[n];
        // store the min. value from index i to the end
        minArr[n-1] = nums[n-1];
        for(int i = n-2; i >=0; i--){
            minArr[i] = Math.min(minArr[i+1], nums[i]);
        }

        for(int i = 0; i < n; i++){
            // max. value from index 0 to i
            max = Math.max(max, nums[i]);

            if(max - minArr[i] <= k){
                return i;
            }
        }
        return -1;
    }
}
