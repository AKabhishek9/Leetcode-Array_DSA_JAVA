// Approach 1 --------------------------------------------------(TC = 20ms)
class Solution {
    public boolean isAnagram(String s, String t) {
        if(s.length() != t.length()){
            return false;
        }
        HashMap<Character, Integer> set = new HashMap<>();
        // add char count of 's' in map
        for(int i = 0; i < s.length(); i++){
            set.put(s.charAt(i), set.getOrDefault(s.charAt(i), 0)+1);
        }
        
        for(int i = 0; i < t.length(); i++){
            // if any char of 't' is not found in map
            if(!set.containsKey(t.charAt(i))){
                return false;
            }
            // if found remove that char count from map by 1
            set.put(t.charAt(i), set.get(t.charAt(i))-1);
            // if that char becomes 0 remove that char key from map
            if(set.get(t.charAt(i)) == 0){
                set.remove(t.charAt(i));
            }
        }
        return true;
    }
}

// Approach 2 -----------------------------------------------------(TC = 4ms)
class Solution {
    public boolean isAnagram(String s, String t) {
        if(s.length() != t.length()){
            return false;
        }

        int freq[] = new int[256];
        // find freq. of every char in 's'
        for(int i = 0; i < s.length(); i++){
            freq[s.charAt(i)]++;
        }

        for(int i = 0; i < t.length(); i++){
            freq[t.charAt(i)]--;
            // if any char count goes in minus means
            // that char is not present in 't'
            if( freq[t.charAt(i)] < 0){
                return false;
            }
        }
        return true;
    }
}

// Approach 3 ----------------------------------------------------(TC = 4ms)
class Solution {
    public boolean isAnagram(String s, String t) {
        if(s.length() != t.length()){
            return false;
        }
        // convert string to array
        char a[] = s.toCharArray();
        char b[] = t.toCharArray();
        // sort array
        Arrays.sort(a);
        Arrays.sort(b);
        // check array is eqaul or not
        return Arrays.equals(a, b);
    }
}

// Approach 4 ---------------------------------------------------(TC = 4ms)
class Solution {
    public boolean isAnagram(String s, String t) {
        int freq[] = new int[26];
        // find count of every char in 's'
        for(int i = 0; i < s.length(); i++){
            char ch = s.charAt(i);
            freq[ch - 'a']++;
        }
        // reduce count of char from freq. if found in 't'
        for(int i = 0; i < t.length(); i++){
            char ch2 = t.charAt(i);
            freq[ch2 - 'a']--;
        }
        // if the freq. of any char is not 0
        for(int i = 0; i < freq.length; i++){
            if(freq[i] != 0){
                return false;
            }
        }
        return true;
    }
}
