// Approach 1 --------------------------------------------(TC = 25ms)
class Solution {
    public boolean containsDuplicate(int nums[]) {
        Arrays.sort(nums);
        for(int i=0; i<nums.length-1; i++){
            if(nums[i] == nums[i+1]){
            return true;
            }
        }
        return false;
    }
}
// Approach 2 ----------------------------------(TC = 18ms)
class Solution {
    public boolean containsDuplicate(int nums[]) {
        HashMap<Integer, Integer> map = new HashMap();
        for(int i = 0; i < nums.length; i++){
            if(map.containsKey(nums[i])){
                return true;
            }
            else{
                map.put(nums[i], i);
            }
        }
        return false;
    }
}

// Approach 3 -----------------------------------------------(BEST TC = 13ms)
class Solution {
    public boolean containsDuplicate(int[] nums) {
        HashSet<Integer> map = new HashSet<>();
        for(int i = 0; i < nums.length; i++){
            // check and add on same time
            if(!map.add(nums[i])){
                return true;
            }
        }
        return false;
    }
}
